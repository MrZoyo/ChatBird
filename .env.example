XIAOMI_API_KEY=sk-...
DISCORD_BOT_TOKEN=...
# The numeric owner ID remains useful for Discord UI component authorization,
# while allow-all opens normal guild messages after guild/channel checks.
DISCORD_ALLOWED_USERS=123456789012345678
DISCORD_ALLOWED_ROLES=
DISCORD_ALLOW_ALL_USERS=true

# ChatBird checks the user and the exact Guild:Channel pair on every turn and
# every tool call. The same mapping gates every non-public slash command.
# Sensitive tools and commands fail closed if the mapping is malformed.
CHATBIRD_ADMIN_USERS=123456789012345678
CHATBIRD_ADMIN_CHANNELS=111111111111111111:222222222222222222,333333333333333333:444444444444444444

# Hermes has one platform-wide Discord home channel for messages without an
# explicit destination. ChatBird also keeps an explicit delivery target per
# Guild. The global target below is intentionally the public test channel.
DISCORD_HOME_CHANNEL=921407984586866781
CHATBIRD_HOME_CHANNELS=111111111111111111:555555555555555555,333333333333333333:666666666666666666
CHATBIRD_DISABLE_HOME_CHANNEL_NOTICE=true

# DMs are recorded to ~/.hermes/logs/chatbird-discord-dm.jsonl with mode 0600
# and are never dispatched to the agent or answered.
CHATBIRD_DISABLE_DM_REPLIES=true
CHATBIRD_LOG_DMS=true

# Keep this explicit because an older .env value takes precedence over YAML.
DISCORD_AUTO_THREAD=false
