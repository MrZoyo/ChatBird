+def _zendesk_article_api_url(
+    url: str, config: Dict[str, Any]
+) -> Optional[tuple[str, str]]:
+    """Map an allowlisted Help Center article page to its public JSON API.
+
+    Returns ``(api_url, article_id)`` or None.  Only exact allowlisted HTTPS
+    hosts and article paths qualify; query strings are never forwarded.
+    """
+    try:
+        parsed = urllib.parse.urlsplit(normalize_url_for_request(url))
+        port = parsed.port
+    except ValueError:
+        return None
+    host = (parsed.hostname or "").lower().rstrip(".")
+    if (
+        parsed.scheme.lower() != "https"
+        or parsed.username
+        or parsed.password
+        or port not in (None, 443)
+        or host not in _configured_hosts(config, "zendesk_article_api_hosts")
+    ):
+        return None
+    match = _ZENDESK_ARTICLE_PATH.match(parsed.path)
+    if not match:
+        return None
+    locale = (match.group("locale") or "").lower()
+    prefix = f"/api/v2/help_center/{locale}" if locale else "/api/v2/help_center"
+    article_id = match.group("id")
+    return f"https://{host}{prefix}/articles/{article_id}.json", article_id
+
+
+def _zendesk_article_extract(
+    url: str, *, min_chars: int, max_chars: int
+) -> tuple[Optional[Dict[str, str]], Optional[str]]:
+    """Read one allowlisted Zendesk Help Center article through its public API.
+
+    Some Help Centers put article pages behind a JavaScript challenge while the
+    documented, unauthenticated Help Center API serves the same published
+    article.  The request goes through the guarded simple-http fetcher, so
+    public-address pinning, redirect checks and size limits still apply.
+    """
+    config = _fallback_config()
+    mapped = _zendesk_article_api_url(url, config)
+    if mapped is None:
+        return None, "URL is not an allowlisted Help Center article"
+    api_url, article_id = mapped
+    if not _safe_public_url(api_url):
+        return None, "Help Center API URL is not allowed"
+    host = (urllib.parse.urlsplit(api_url).hostname or "").lower()
+
+    from plugins.web.simple_http.provider import _ReadableHTML, _fetch
+
+    try:
+        final_url, content_type, data, charset = _fetch(api_url)
+    except (ValueError, OSError, http.client.HTTPException) as exc:
+        return None, f"Help Center API request failed: {exc}"
+    if (urllib.parse.urlsplit(final_url).hostname or "").lower() != host:
+        return None, "Help Center API crossed the allowed host"
+    if content_type != "application/json":
+        return None, "Help Center API returned an unsupported content type"
+    try:
+        article = json.loads(data.decode(charset or "utf-8", errors="replace"))["article"]
+    except (ValueError, KeyError, TypeError, LookupError):
+        return None, "Help Center API returned malformed JSON"
+    if not isinstance(article, dict) or str(article.get("id")) != article_id:
+        return None, "Help Center API returned a different article"
+    if article.get("draft"):
+        return None, "Help Center API returned a draft article"
+    html_url = str(article.get("html_url") or "")
+    if (urllib.parse.urlsplit(html_url).hostname or "").lower() != host:
+        return None, "Help Center API returned an unexpected article URL"
+
+    parser = _ReadableHTML()
+    parser.feed(str(article.get("body") or ""))
+    body = parser.markdown()
+    title = str(article.get("title") or "").strip()
+    if len(body.strip()) < min_chars or _challenge_page(title, body):
+        return None, "Help Center API returned empty or challenge-protected content"
+    header = f"# {title}\n\n" if title else ""
+    updated = str(article.get("updated_at") or "").strip()
+    if updated:
+        header += f"Last updated: {updated}\n\n"
+    return {
+        "url": html_url,
+        "title": title,
+        "content": (header + body)[:max_chars],
+    }, None
+
