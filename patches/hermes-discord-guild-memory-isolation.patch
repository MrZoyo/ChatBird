+def get_memory_dir(namespace: Optional[str] = None) -> Path:
+    """Return the profile- and tenant-scoped memories directory.
+
+    The legacy unscoped location remains unchanged for CLI and non-tenant
+    callers.  Gateway adapters can provide a conservative identifier such as
+    ``discord-guild-123`` so persistent memory never crosses tenant borders.
+    """
+    base = get_hermes_home() / "memories"
+    if not namespace:
+        return base
+    value = str(namespace).strip()
+    safe_chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-"
+    if (
+        not value
+        or len(value) > 160
+        or any(ch not in safe_chars for ch in value)
+    ):
+        raise ValueError("memory namespace must contain only letters, numbers, '.', '_' or '-'")
+    return base / "scopes" / value
 
 ENTRY_DELIMITER = "\n§\n"
 
