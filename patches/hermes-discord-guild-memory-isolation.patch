+def get_memory_dir(namespace: Optional[str] = None) -> Path:
+    """Profile-scoped memories dir, resolved per call (HERMES_HOME may switch after import).
+    A namespace such as ``discord-guild-123`` selects a separate tenant directory; the unscoped
+    location stays the CLI's."""
+    base = get_hermes_home() / "memories"
+    if not namespace:
+        return base
+    value = str(namespace).strip()
+    if not value or len(value) > 160 or not value.isascii() or any(not (ch.isalnum() or ch in "._-") for ch in value) \
+            or set(value) == {"."}:
+        raise ValueError("memory namespace must contain only letters, numbers, '.', '_' or '-'")
+    return base / "scopes" / value
 
 
