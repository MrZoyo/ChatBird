diff --git a/tests/gateway/test_discord_guild_memory_isolation.py b/tests/gateway/test_discord_guild_memory_isolation.py
new file mode 100644
index 00000000..90346fd3
--- /dev/null
+++ b/tests/gateway/test_discord_guild_memory_isolation.py
@@ -0,0 +1,97 @@
+from types import SimpleNamespace
+
+from gateway.config import Platform
+from gateway.session import SessionSource, build_session_key
+from plugins.platforms.discord.adapter import DiscordAdapter
+from tools.memory_tool import MemoryStore, get_memory_dir
+
+
+def _discord_source(guild_id: str) -> SessionSource:
+    return SessionSource(
+        platform=Platform.DISCORD,
+        chat_id="123456789",
+        chat_type="group",
+        user_id="42",
+        guild_id=guild_id,
+    )
+
+
+def test_discord_session_key_includes_guild_without_moving_chat_id():
+    first = build_session_key(_discord_source("100"))
+    second = build_session_key(_discord_source("200"))
+
+    assert first != second
+    assert first.split(":")[4] == "123456789"
+    assert first.endswith(":guild-100")
+    assert second.endswith(":guild-200")
+
+
+def test_discord_guild_memory_directories_do_not_share_entries(monkeypatch, tmp_path):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path / ".hermes"))
+
+    first = MemoryStore(memory_namespace="discord-guild-100")
+    first.load_from_disk()
+    assert first.add("memory", "Only guild 100 should know this.")["success"]
+
+    second = MemoryStore(memory_namespace="discord-guild-200")
+    second.load_from_disk()
+
+    assert first._path_for("memory") != second._path_for("memory")
+    assert second.memory_entries == []
+
+    reloaded_first = MemoryStore(memory_namespace="discord-guild-100")
+    reloaded_first.load_from_disk()
+    assert reloaded_first.memory_entries == ["Only guild 100 should know this."]
+
+
+def test_unscoped_memory_path_remains_backward_compatible(monkeypatch, tmp_path):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path / ".hermes"))
+
+    assert get_memory_dir() == tmp_path / ".hermes" / "memories"
+
+
+def test_memory_namespace_rejects_path_traversal(monkeypatch, tmp_path):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path / ".hermes"))
+
+    try:
+        get_memory_dir("../another-guild")
+    except ValueError:
+        pass
+    else:
+        raise AssertionError("path-traversing memory namespace was accepted")
+
+
+def _authorization_adapter() -> DiscordAdapter:
+    adapter = object.__new__(DiscordAdapter)
+    adapter._allowed_user_ids = set()
+    adapter._allowed_role_ids = set()
+    adapter._is_allowed_user = lambda *args, **kwargs: True
+    return adapter
+
+
+def _guild_interaction(guild_id: str):
+    return SimpleNamespace(
+        channel=SimpleNamespace(id=10),
+        channel_id=10,
+        guild=SimpleNamespace(id=int(guild_id)),
+        user=SimpleNamespace(id=42),
+    )
+
+
+def test_allowed_guild_can_use_slash_commands(monkeypatch):
+    monkeypatch.setenv("DISCORD_ALLOWED_GUILDS", "100")
+
+    assert _authorization_adapter()._evaluate_slash_authorization(
+        _guild_interaction("100")
+    ) == (True, None)
+
+
+def test_unknown_guild_cannot_use_slash_commands(monkeypatch):
+    monkeypatch.setenv("DISCORD_ALLOWED_GUILDS", "100")
+
+    allowed, reason = _authorization_adapter()._evaluate_slash_authorization(
+        _guild_interaction("200")
+    )
+
+    assert allowed is False
+    assert reason == "guild not in discord.allowed_guilds"
