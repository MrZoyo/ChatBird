@@ -0,0 +1,35 @@
+import plugins.memory.mem0 as mem0_module
+
+
+def test_configured_mem0_principal_is_scoped_to_discord_guild(monkeypatch):
+    provider = mem0_module.Mem0MemoryProvider()
+    monkeypatch.setattr(
+        mem0_module,
+        "_load_config",
+        lambda: {"mode": "platform", "user_id": "canonical-user"},
+    )
+    monkeypatch.setattr(provider, "_create_backend", lambda: None)
+
+    provider.initialize(
+        "session-1",
+        platform="discord",
+        user_id="42",
+        memory_namespace="discord-guild-100",
+    )
+
+    assert provider._user_id == "discord-guild-100:canonical-user"
+
+
+def test_mem0_principal_is_not_double_scoped(monkeypatch):
+    provider = mem0_module.Mem0MemoryProvider()
+    monkeypatch.setattr(mem0_module, "_load_config", lambda: {"mode": "platform"})
+    monkeypatch.setattr(provider, "_create_backend", lambda: None)
+
+    provider.initialize(
+        "session-1",
+        platform="discord",
+        user_id="discord-guild-100:42",
+        memory_namespace="discord-guild-100",
+    )
+
+    assert provider._user_id == "discord-guild-100:42"
