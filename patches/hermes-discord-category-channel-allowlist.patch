+    @staticmethod
+    def _session_key_targets_discord_channel(session_key: str, channel_id: str) -> bool:
+        """Return whether a session key belongs to a Discord guild channel."""
+        parts = str(session_key).split(":")
+        target = str(channel_id)
+        return any(
+            parts[index] == "discord"
+            and parts[index + 1] in {"group", "channel"}
+            and parts[index + 2] == target
+            for index in range(max(0, len(parts) - 2))
+        )
+
+    async def _cancel_deleted_channel_sessions(self, channel: Any) -> int:
+        """Cancel live and buffered turns for a deleted Discord guild channel.
+
+        Persistent transcripts remain available under the normal Hermes
+        retention policy. A newly created temporary channel receives a new
+        Discord snowflake and therefore a separate session key.
+        """
+        channel_id = getattr(channel, "id", None)
+        if channel_id is None:
+            return 0
+
+        candidate_keys = set(self._active_sessions)
+        candidate_keys.update(self._pending_messages)
+        candidate_keys.update(self._text_debounce_store())
+        candidate_keys.update(self._pending_text_batches)
+        candidate_keys.update(self._pending_text_batch_tasks)
+        target_keys = {
+            key
+            for key in candidate_keys
+            if self._session_key_targets_discord_channel(key, str(channel_id))
+        }
+
+        for key in target_keys:
+            batch_task = self._pending_text_batch_tasks.pop(key, None)
+            if batch_task is not None and not batch_task.done():
+                batch_task.cancel()
+            self._pending_text_batches.pop(key, None)
+
+        if target_keys:
+            await asyncio.gather(
+                *(self.cancel_session_processing(key) for key in target_keys)
+            )
+            logger.info(
+                "[%s] Stopped %d session(s) for deleted Discord channel %s",
+                self.name,
+                len(target_keys),
+                channel_id,
+            )
+        return len(target_keys)
+
