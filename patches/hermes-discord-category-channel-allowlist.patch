+# ── allowed_channels ─────────────────────────────────────────────────
+
+
+@pytest.mark.asyncio
+async def test_allowed_category_processes_child_text_channel(adapter, monkeypatch):
+    """Text channels inherit allowed_channels membership from their category."""
+    monkeypatch.setenv("DISCORD_ALLOWED_CHANNELS", "500")
+    monkeypatch.setenv("DISCORD_REQUIRE_MENTION", "true")
+    monkeypatch.setenv("DISCORD_AUTO_THREAD", "false")
+    monkeypatch.setenv("DISCORD_HISTORY_BACKFILL", "false")
+    monkeypatch.delenv("DISCORD_IGNORED_CHANNELS", raising=False)
+    monkeypatch.delenv("DISCORD_FREE_RESPONSE_CHANNELS", raising=False)
+
+    category = SimpleNamespace(id=500)
+    bot_user = adapter._client.user
+    message = make_message(
+        channel=FakeTextChannel(channel_id=501, category=category),
+        content=f"<@{bot_user.id}> hello",
+        mentions=[bot_user],
+    )
+    await adapter._handle_message(message)
+
+    adapter.handle_message.assert_awaited_once()
+
+
+@pytest.mark.asyncio
+async def test_allowed_category_authorizes_child_channel_slash_command(adapter, monkeypatch):
+    """Slash commands inherit allowed_channels membership from their category."""
+    monkeypatch.setenv("DISCORD_ALLOWED_CHANNELS", "500")
+    monkeypatch.delenv("DISCORD_IGNORED_CHANNELS", raising=False)
+    monkeypatch.delenv("CHATBIRD_ADMIN_USERS", raising=False)
+    monkeypatch.delenv("CHATBIRD_ADMIN_CHANNELS", raising=False)
+
+    category = SimpleNamespace(id=500)
+    channel = FakeTextChannel(channel_id=501, category=category)
+    interaction = SimpleNamespace(
+        channel_id=channel.id,
+        channel=channel,
+        guild=SimpleNamespace(id=600),
+        guild_id=600,
+        user=SimpleNamespace(id=42, roles=[]),
+    )
+
+    allowed, reason = adapter._evaluate_slash_authorization(interaction, "/status")
+
+    assert allowed is True
+    assert reason is None
+
+
 # ── ignored_channels ─────────────────────────────────────────────────
 
 
