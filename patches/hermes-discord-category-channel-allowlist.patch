+@pytest.mark.asyncio
+async def test_deleted_channel_cancels_active_and_buffered_sessions(adapter):
+    """Deleting a temporary channel stops work without matching sibling sessions."""
+    target_active = "agent:main:discord:group:501:guild-600"
+    target_buffered = "agent:main:discord:group:501:42:guild-600"
+    sibling = "agent:main:discord:group:502:guild-600"
+    batch_task = MagicMock()
+    batch_task.done.return_value = False
+
+    adapter._active_sessions[target_active] = asyncio.Event()
+    adapter._pending_text_batches[target_buffered] = object()
+    adapter._pending_text_batch_tasks[target_buffered] = batch_task
+    adapter._active_sessions[sibling] = asyncio.Event()
+    adapter.cancel_session_processing = AsyncMock()
+
+    count = await adapter._cancel_deleted_channel_sessions(SimpleNamespace(id=501))
+
+    assert count == 2
+    assert {call.args[0] for call in adapter.cancel_session_processing.await_args_list} == {
+        target_active,
+        target_buffered,
+    }
+    assert target_buffered not in adapter._pending_text_batches
+    assert target_buffered not in adapter._pending_text_batch_tasks
+    batch_task.cancel.assert_called_once_with()
