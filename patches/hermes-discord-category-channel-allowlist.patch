+def test_thread_inherits_its_parent_channel_but_not_a_category(adapter):
+    """A thread reads parent/parent_id. Its category must not widen the channel allowlist."""
+    parent = FakeTextChannel(channel_id=501, category=SimpleNamespace(id=500))
+    thread = FakeThread(channel_id=601, parent=parent)
+    thread.category = parent.category
+
+    keys = adapter._discord_channel_keys_from_channel(thread)
+
+    assert "501" in keys
+    assert "500" not in keys
+
