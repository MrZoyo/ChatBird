+    @staticmethod
+    def _chatbird_dm_replies_disabled() -> bool:
+        return os.getenv("CHATBIRD_DISABLE_DM_REPLIES", "true").strip().lower() in {"true", "1", "yes"}
+
+    def _schedule_chatbird_dm_log(self, message: DiscordMessage) -> None:
+        """Record a human DM off the ingress path, unless ``CHATBIRD_LOG_DMS`` turns it off."""
+        if os.getenv("CHATBIRD_LOG_DMS", "true").strip().lower() not in {"true", "1", "yes"}:
+            return
+        task = asyncio.get_running_loop().create_task(self._log_chatbird_dm(message))
+        self._background_tasks.add(task)
+        task.add_done_callback(self._background_tasks.discard)
+
+    async def _log_chatbird_dm(self, message: DiscordMessage) -> None:
+        """Append a bounded, mode-0600 DM record without invoking Hermes.
+
+        The log stores text and attachment metadata only; it never downloads a DM file. The
+        administrator can inspect this file from the private admin channel with the admin tools.
+        """
+        from hermes_constants import get_hermes_home
+
+        path = get_hermes_home() / "logs" / "chatbird-discord-dm.jsonl"
+        entry = {
+            "timestamp": getattr(getattr(message, "created_at", None), "isoformat", lambda: "")(),
+            "message_id": str(getattr(message, "id", "") or ""),
+            "user_id": str(getattr(getattr(message, "author", None), "id", "") or ""),
+            "user_name": str(getattr(getattr(message, "author", None), "display_name", "") or ""),
+            "channel_id": str(getattr(getattr(message, "channel", None), "id", "") or ""),
+            "content": str(getattr(message, "content", "") or "")[:12000],
+            "attachments": [
+                {
+                    "id": str(getattr(att, "id", "") or ""),
+                    "filename": str(getattr(att, "filename", "") or "")[:240],
+                    "content_type": str(getattr(att, "content_type", "") or ""),
+                    "size": int(getattr(att, "size", 0) or 0),
+                }
+                for att in (getattr(message, "attachments", None) or [])
+            ],
+        }
+
+        def _append() -> None:
+            path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
+            fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
+            with os.fdopen(fd, "a", encoding="utf-8") as stream:
+                os.chmod(path, 0o600)
+                stream.write(json.dumps(entry, ensure_ascii=False) + "\n")
+
+        try:
+            await asyncio.to_thread(_append)
+        except Exception:
+            logger.warning("[%s] Failed to record a Discord DM", self.name, exc_info=True)
+
