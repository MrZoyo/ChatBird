+        if not channel_ids:
+            return (False, "missing administrator channel id")
+        admin_channels = {value.strip() for value in admin_channels_raw.split(",") if value.strip()}
+        if not any(f"{guild_id}:{candidate}" in admin_channels for candidate in channel_ids):
+            return (False, "slash command is restricted to this guild's administrator channel")
