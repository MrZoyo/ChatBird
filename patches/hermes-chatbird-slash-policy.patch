+        command_name = command_parts[0].lstrip("/").lower()
+        if not command_name:
+            return (False, "missing slash command name")
+        if guild_id is None:
+            return (False, "ChatBird slash commands are disabled in DMs")
+        if command_name in _CHATBIRD_PUBLIC_COMMANDS:
+            return (True, None)
+        if user_id is None:
+            return (False, "missing administrator user id")
+        admin_users = {value.strip() for value in admin_users_raw.split(",") if value.strip()}
+        if str(user_id) not in admin_users:
+            return (False, "slash command is restricted to ChatBird administrators")
