+    def _evaluate_chatbird_command_policy(
+        self, command_text: str, *, user_id: Any, guild_id: Any, channel_id: Any, channel: Any,
+    ) -> tuple[bool, Optional[str]]:
+        """ChatBird's command gate, for native slash commands and for typed ones alike. A few
+        read-only commands are public inside a guild; everything else needs the administrator's user
+        ID in that guild's administrator channel (or a thread under it)."""
+        admin_users_raw = os.getenv("CHATBIRD_ADMIN_USERS", "")
+        admin_channels_raw = os.getenv("CHATBIRD_ADMIN_CHANNELS", "")
+        # A deployment with no ChatBird settings keeps Hermes's own command handling. discord.allowed_guilds
+        # marks a ChatBird deployment, where a lost admin setting must close the gate, not open it.
+        if not admin_users_raw and not admin_channels_raw and not self._discord_allowed_guilds():
+            return (True, None)
+        command_parts = (command_text or "").strip().split(maxsplit=1)
+        if not command_parts:
