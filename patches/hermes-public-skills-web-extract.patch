@@ -0,0 +1,324 @@
+"""Fail-closed visibility and review state for ChatBird public skills.
+
+Public approval is stored outside skill directories and is bound to a digest
+of every file the skill reader could expose.  Editing any file therefore
+removes the skill from public Discord views until it is reviewed again.
+"""
+
+from __future__ import annotations
+
+import contextvars
+import hashlib
+import json
+import os
+import re
+import tempfile
+import threading
+from dataclasses import dataclass
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Callable, Optional
+
+from hermes_constants import get_hermes_home
+from utils import atomic_replace
+
+
+_MANIFEST_LOCK = threading.RLock()
+_REVIEW_CALLBACK: contextvars.ContextVar[Optional[Callable[[Path, str], "ReviewDecision"]]] = (
+    contextvars.ContextVar("chatbird_public_skill_reviewer", default=None)
+)
+_GUILD_SUFFIX_RE = re.compile(r"(?:^|:)guild-(\d+)(?:$|:)")
+_FORBIDDEN_PUBLIC_SKILL_PATTERNS = (
+    (re.compile(r"(?i)\b(?:terminal|shell|bash|powershell|execute_code|delegate_task|send_message|computer_use|browser|read_file|write_file|apply_patch|ssh|scp)\b"),
+     "references a tool unavailable in public channels"),
+    (re.compile(r"(?i)\b(?:skill_manage|memory|session|schedule|cron|admin(?:istrator)?|systemd|service)\b"),
+     "references stateful or administrative capabilities"),
+    (re.compile(r"(?i)(?:api[_ -]?key|access[_ -]?token|password|credential|secret|\.env)"),
+     "references credentials or secret-bearing configuration"),
+    (re.compile(r"(?i)(?:/root/|/etc/|/proc/|/sys/|~[/\\]|HERMES_HOME|HERMES_SKILL_DIR|HERMES_SESSION_ID|CHATBIRD_ADMIN)"),
+     "references host or privileged paths/configuration"),
+    (re.compile(r"(?i)(?:localhost|(?:127|10|0)\.\d{1,3}\.\d{1,3}\.\d{1,3}|172\.(?:1[6-9]|2\d|3[01])\.\d{1,3}\.\d{1,3}|192\.168\.\d{1,3}\.\d{1,3}|169\.254\.\d{1,3}\.\d{1,3}|::1|f[cd][0-9a-f]*:|fe80:|metadata\.google\.internal)"),
+     "references local or metadata network targets"),
+    (re.compile(r"!`[^`\n]*`"),
+     "contains executable inline shell syntax"),
+    (re.compile(r"(?:\$\{[^}\n]+\}|\{\{.*?\}\}|\{%.*?%\}|<%.*?%>)"),
+     "contains dynamic template syntax"),
+    (re.compile(r"<!--[\s\S]*?-->"),
+     "contains hidden HTML instructions"),
+    (re.compile(r"(?i)(?:ignore|bypass|override|disregard).{0,40}(?:policy|permission|system|instruction|guard)"),
+     "attempts to bypass policy or higher-priority instructions"),
+)
+_PUBLIC_TEXT_SUFFIXES = frozenset({".md", ".txt", ".json", ".yaml", ".yml", ".csv", ".tsv"})
+_INVISIBLE_INSTRUCTION_RE = re.compile(
+    "[\u200b\u200c\u200d\u2060\ufeff\u202a-\u202e\u2066-\u2069]"
+)
+
+
+@dataclass(frozen=True)
+class ReviewDecision:
+    approved: bool
+    reason: str
+    reviewer: str = ""
+
+
+def _session_value(name: str) -> str:
+    try:
+        from gateway.session_context import get_session_env
+
+        return str(get_session_env(name, "") or "")
+    except Exception:
+        return ""
+
+
+def _discord_context() -> dict[str, str]:
+    session_key = _session_value("HERMES_SESSION_KEY")
+    match = _GUILD_SUFFIX_RE.search(session_key)
+    return {
+        "platform": _session_value("HERMES_SESSION_PLATFORM").lower(),
+        "guild_id": match.group(1) if match else "",
+        "user_id": _session_value("HERMES_SESSION_USER_ID"),
+        "chat_id": _session_value("HERMES_SESSION_CHAT_ID"),
+    }
+
+
+def _csv_env(name: str) -> set[str]:
+    return {item.strip() for item in os.getenv(name, "").split(",") if item.strip()}
+
+
+def _admin_pairs() -> set[tuple[str, str]]:
+    pairs: set[tuple[str, str]] = set()
+    for item in _csv_env("CHATBIRD_ADMIN_CHANNELS"):
+        guild_id, separator, channel_id = item.partition(":")
+        if separator and guild_id.isdigit() and channel_id.isdigit():
+            pairs.add((guild_id, channel_id))
+    return pairs
+
+
+def is_public_discord_context() -> bool:
+    """Filter every Discord turn unless it is a fully identified admin turn.
+
+    Missing guild/user/channel identity cannot prove administrator status, so
+    it deliberately falls into the public, fail-closed view.
+    """
+    ctx = _discord_context()
+    if ctx["platform"] != "discord":
+        return False
+    is_admin = (
+        ctx["guild_id"].isdigit()
+        and ctx["user_id"].isdigit()
+        and ctx["chat_id"].isdigit()
+        and ctx["user_id"] in _csv_env("CHATBIRD_ADMIN_USERS")
+        and (ctx["guild_id"], ctx["chat_id"]) in _admin_pairs()
+    )
+    return not is_admin
+
+
+def _manifest_path() -> Path:
+    return get_hermes_home() / "chatbird" / "public-skill-approvals.json"
+
+
+def _read_manifest() -> dict:
+    try:
+        payload = json.loads(_manifest_path().read_text(encoding="utf-8"))
+    except (FileNotFoundError, OSError, ValueError, TypeError):
+        return {"version": 1, "skills": {}}
+    if not isinstance(payload, dict) or payload.get("version") != 1:
+        return {"version": 1, "skills": {}}
+    if not isinstance(payload.get("skills"), dict):
+        return {"version": 1, "skills": {}}
+    return payload
+
+
+def _write_manifest(payload: dict) -> None:
+    path = _manifest_path()
+    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
+    fd, tmp_name = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.")
+    try:
+        with os.fdopen(fd, "w", encoding="utf-8") as stream:
+            json.dump(payload, stream, ensure_ascii=False, indent=2, sort_keys=True)
+            stream.write("\n")
+            stream.flush()
+            os.fsync(stream.fileno())
+        os.chmod(tmp_name, 0o600)
+        atomic_replace(tmp_name, path)
+    finally:
+        try:
+            os.unlink(tmp_name)
+        except FileNotFoundError:
+            pass
+
+
+def skill_content_digest(skill_path: Path) -> Optional[str]:
+    """Hash all regular files beneath a skill, rejecting links and odd files."""
+    try:
+        root = skill_path.resolve(strict=True)
+        if root.is_file():
+            if skill_path.is_symlink():
+                return None
+            files = [root]
+            base = root.parent
+        elif root.is_dir():
+            entries = sorted(root.rglob("*"))
+            if any(path.is_symlink() for path in entries):
+                return None
+            if any(not path.is_dir() and not path.is_file() for path in entries):
+                return None
+            files = [path for path in entries if path.is_file()]
+            base = root
+        else:
+            return None
+        if not files or not any(path.name == "SKILL.md" for path in files):
+            return None
+
+        digest = hashlib.sha256()
+        total = 0
+        for path in files:
+            if path.is_symlink():
+                return None
+            resolved = path.resolve(strict=True)
+            resolved.relative_to(base)
+            data = resolved.read_bytes()
+            total += len(data)
+            if total > 2 * 1024 * 1024:
+                return None
+            relative = resolved.relative_to(base).as_posix().encode("utf-8")
+            digest.update(len(relative).to_bytes(4, "big"))
+            digest.update(relative)
+            digest.update(len(data).to_bytes(8, "big"))
+            digest.update(data)
+        return digest.hexdigest()
+    except (OSError, ValueError, RuntimeError):
+        return None
+
+
+def validate_public_skill_content(skill_path: Path) -> Optional[str]:
+    """Return a rejection reason when a candidate exceeds public capabilities."""
+    try:
+        root = skill_path.resolve(strict=True)
+        files = [root] if root.is_file() else sorted(root.rglob("*"))
+        if skill_path.is_symlink() or any(path.is_symlink() for path in files):
+            return "Public skills may not contain symbolic links."
+        if any(not path.is_dir() and not path.is_file() for path in files):
+            return "Public skills may contain only regular text files and directories."
+        regular_files = [path for path in files if path.is_file()]
+        if not regular_files or not any(path.name == "SKILL.md" for path in regular_files):
+            return "Candidate is missing SKILL.md."
+        for path in regular_files:
+            relative = path.name if root.is_file() else path.relative_to(root).as_posix()
+            if relative.startswith("scripts/") or path.suffix.lower() not in _PUBLIC_TEXT_SUFFIXES:
+                return f"Public skills may contain only inert text resources; rejected '{relative}'."
+            try:
+                content = path.read_text(encoding="utf-8")
+            except (OSError, UnicodeError):
+                return f"Public skill resource '{relative}' is unreadable text."
+            if _INVISIBLE_INSTRUCTION_RE.search(content):
+                return f"Public skill resource '{relative}' contains hidden or bidirectional text."
+            for pattern, reason in _FORBIDDEN_PUBLIC_SKILL_PATTERNS:
+                match = pattern.search(content)
+                if match:
+                    return f"{relative} {reason}: '{match.group(0)[:80]}'."
+        return None
+    except (OSError, ValueError, RuntimeError) as exc:
+        return f"Candidate could not be safely inspected: {exc}"
+
+
+def _approval_key(skill_path: Path, public_name: str) -> str:
+    try:
+        canonical = str(skill_path.resolve(strict=True))
+    except OSError:
+        canonical = str(skill_path.absolute())
+    return hashlib.sha256(f"{public_name}\0{canonical}".encode("utf-8")).hexdigest()
+
+
+def is_skill_publicly_approved(skill_path: Path, public_name: str) -> bool:
+    """Fail closed unless the external approval matches current content."""
+    digest = skill_content_digest(skill_path)
+    if not digest:
+        return False
+    with _MANIFEST_LOCK:
+        entry = _read_manifest()["skills"].get(_approval_key(skill_path, public_name))
+    return (
+        isinstance(entry, dict)
+        and entry.get("name") == public_name
+        and entry.get("sha256") == digest
+        and entry.get("status") == "approved"
+    )
+
+
+def record_public_approval(
+    skill_path: Path,
+    public_name: str,
+    *,
+    reviewer: str,
+    reason: str,
+) -> bool:
+    if validate_public_skill_content(skill_path):
+        return False
+    digest = skill_content_digest(skill_path)
+    if not digest:
+        return False
+    with _MANIFEST_LOCK:
+        payload = _read_manifest()
+        payload["skills"][_approval_key(skill_path, public_name)] = {
+            "name": public_name,
+            "path": str(skill_path.resolve()),
+            "sha256": digest,
+            "status": "approved",
+            "reviewer": reviewer,
+            "reason": reason[:500],
+            "reviewed_at": datetime.now(timezone.utc).isoformat(),
+        }
+        _write_manifest(payload)
+    return True
+
+
+def revoke_public_approval(skill_path: Path, public_name: str) -> None:
+    with _MANIFEST_LOCK:
+        payload = _read_manifest()
+        payload["skills"].pop(_approval_key(skill_path, public_name), None)
+        _write_manifest(payload)
+
+
+def public_approval_cache_token() -> str:
+    """Return a cache discriminator that changes on approval or skill edits."""
+    if not is_public_discord_context():
+        return "private"
+    with _MANIFEST_LOCK:
+        payload = _read_manifest()
+    digest = hashlib.sha256(json.dumps(payload, sort_keys=True).encode("utf-8"))
+    # Include current content digests, not only mtimes and sizes. This keeps the
+    # prompt LRU hash-bound even if an out-of-band edit preserves filesystem
+    # metadata.
+    for entry in payload.get("skills", {}).values():
+        if not isinstance(entry, dict) or not isinstance(entry.get("path"), str):
+            digest.update(b"malformed-path")
+            continue
+        try:
+            root = Path(entry["path"]).resolve(strict=True)
+            current = skill_content_digest(root)
+            digest.update(str(root).encode("utf-8"))
+            digest.update((current or "unreadable").encode("ascii"))
+        except OSError:
+            digest.update(b"unreadable")
+    return digest.hexdigest()
+
+
+def set_public_skill_reviewer(callback: Callable[[Path, str], ReviewDecision]):
+    return _REVIEW_CALLBACK.set(callback)
+
+
+def reset_public_skill_reviewer(token) -> None:
+    _REVIEW_CALLBACK.reset(token)
+
+
+def review_public_skill(skill_path: Path, public_name: str) -> ReviewDecision:
+    callback = _REVIEW_CALLBACK.get()
+    if callback is None:
+        return ReviewDecision(False, "No independent public-skill reviewer is available.")
+    try:
+        decision = callback(skill_path, public_name)
+    except Exception as exc:
+        return ReviewDecision(False, f"Independent public-skill review failed: {exc}")
+    if not isinstance(decision, ReviewDecision):
+        return ReviewDecision(False, "Independent public-skill reviewer returned malformed output.")
+    return decision
