diff --git a/plugins/web/simple_http/provider.py b/plugins/web/simple_http/provider.py
new file mode 100644
index 0000000000..c2899dd7d0
--- /dev/null
+++ b/plugins/web/simple_http/provider.py
@@ -0,0 +1,319 @@
+"""Small extraction-only provider for static HTML and text resources."""
+
+from __future__ import annotations
+
+import gzip
+import http.client
+import ipaddress
+import io
+import re
+import socket
+import urllib.error
+import urllib.parse
+import urllib.request
+import zlib
+from html.parser import HTMLParser
+from typing import Any, Dict, List
+
+from agent.web_search_provider import WebSearchProvider
+from tools.url_safety import is_safe_url, normalize_url_for_request
+
+
+_MAX_DOWNLOAD_BYTES = 4 * 1024 * 1024
+_MAX_DECOMPRESSED_BYTES = 8 * 1024 * 1024
+_MAX_REDIRECTS = 5
+_TIMEOUT_SECONDS = 20
+_ALLOWED_CONTENT_TYPES = (
+    "text/html",
+    "application/xhtml+xml",
+    "text/plain",
+    "application/json",
+    "application/xml",
+    "text/xml",
+)
+
+
+class _NoRedirect(urllib.request.HTTPRedirectHandler):
+    def redirect_request(self, req, fp, code, msg, headers, newurl):
+        return None
+
+
+def _is_public_address(raw_address: str) -> bool:
+    address = raw_address.split("%", 1)[0]
+    try:
+        parsed = ipaddress.ip_address(address)
+    except ValueError:
+        return False
+    if isinstance(parsed, ipaddress.IPv6Address) and parsed.ipv4_mapped is not None:
+        parsed = parsed.ipv4_mapped
+    return parsed.is_global
+
+
+def _connect_public_address(address, timeout, source_address=None):
+    """Resolve once, reject every non-public answer, then connect by sockaddr."""
+    host, port = address
+    addresses = socket.getaddrinfo(host, port, socket.AF_UNSPEC, socket.SOCK_STREAM)
+    if not addresses:
+        raise OSError(f"DNS returned no addresses for {host}")
+    if any(not _is_public_address(sockaddr[0]) for *_prefix, sockaddr in addresses):
+        raise ValueError("Blocked: resolved target is a private or internal network address")
+
+    last_error: OSError | None = None
+    for family, socktype, proto, _canonname, sockaddr in addresses:
+        sock = None
+        try:
+            sock = socket.socket(family, socktype, proto)
+            if timeout is not socket._GLOBAL_DEFAULT_TIMEOUT:
+                sock.settimeout(timeout)
+            if source_address:
+                sock.bind(source_address)
+            sock.connect(sockaddr)
+            return sock
+        except OSError as exc:
+            last_error = exc
+            if sock is not None:
+                sock.close()
+    if last_error is not None:
+        raise last_error
+    raise OSError(f"Could not connect to {host}")
+
+
+class _PublicHTTPConnection(http.client.HTTPConnection):
+    def connect(self) -> None:
+        self.sock = _connect_public_address(
+            (self.host, self.port), self.timeout, self.source_address
+        )
+        if self._tunnel_host:
+            self._tunnel()
+
+
+class _PublicHTTPSConnection(http.client.HTTPSConnection):
+    def connect(self) -> None:
+        self.sock = _connect_public_address(
+            (self.host, self.port), self.timeout, self.source_address
+        )
+        server_hostname = self.host
+        if self._tunnel_host:
+            self._tunnel()
+            server_hostname = self._tunnel_host
+        self.sock = self._context.wrap_socket(self.sock, server_hostname=server_hostname)
+
+
+class _PublicHTTPHandler(urllib.request.HTTPHandler):
+    def http_open(self, request):
+        return self.do_open(_PublicHTTPConnection, request)
+
+
+class _PublicHTTPSHandler(urllib.request.HTTPSHandler):
+    def https_open(self, request):
+        return self.do_open(_PublicHTTPSConnection, request)
+
+
+class _ReadableHTML(HTMLParser):
+    _BLOCKED = frozenset({"script", "style", "noscript", "svg", "canvas", "template"})
+    _BLOCKS = frozenset(
+        {
+            "address", "article", "aside", "blockquote", "br", "div", "dl", "dt", "dd",
+            "figcaption", "figure", "footer", "form", "h1", "h2", "h3", "h4", "h5", "h6",
+            "header", "hr", "li", "main", "nav", "ol", "p", "pre", "section", "table",
+            "tbody", "td", "tfoot", "th", "thead", "tr", "ul",
+        }
+    )
+
+    def __init__(self) -> None:
+        super().__init__(convert_charrefs=True)
+        self.parts: list[str] = []
+        self.title_parts: list[str] = []
+        self._blocked_depth = 0
+        self._in_title = False
+        self._link_href = ""
+
+    def handle_starttag(self, tag: str, attrs) -> None:
+        tag = tag.lower()
+        if tag in self._BLOCKED:
+            self._blocked_depth += 1
+            return
+        if self._blocked_depth:
+            return
+        if tag == "title":
+            self._in_title = True
+        if tag == "a":
+            self._link_href = dict(attrs).get("href", "")
+        if tag in self._BLOCKS:
+            self.parts.append("\n")
+        if tag == "li":
+            self.parts.append("- ")
+        if tag in {"h1", "h2", "h3", "h4", "h5", "h6"}:
+            self.parts.append("#" * int(tag[1]) + " ")
+        if tag in {"td", "th"}:
+            self.parts.append(" | ")
+
+    def handle_endtag(self, tag: str) -> None:
+        tag = tag.lower()
+        if tag in self._BLOCKED:
+            if self._blocked_depth:
+                self._blocked_depth -= 1
+            return
+        if self._blocked_depth:
+            return
+        if tag == "title":
+            self._in_title = False
+        if tag == "a" and self._link_href:
+            href = self._link_href.strip()
+            if href.startswith(("http://", "https://")):
+                self.parts.append(f" ({href})")
+            self._link_href = ""
+        if tag in self._BLOCKS:
+            self.parts.append("\n")
+
+    def handle_data(self, data: str) -> None:
+        if self._blocked_depth:
+            return
+        text = re.sub(r"\s+", " ", data).strip()
+        if not text:
+            return
+        if self._in_title:
+            self.title_parts.append(text)
+        self.parts.append(text + " ")
+
+    @property
+    def title(self) -> str:
+        return " ".join(self.title_parts).strip()
+
+    def markdown(self) -> str:
+        text = "".join(self.parts)
+        text = re.sub(r"[ \t]+\n", "\n", text)
+        text = re.sub(r"\n[ \t]+", "\n", text)
+        text = re.sub(r"[ \t]{2,}", " ", text)
+        text = re.sub(r"\n{3,}", "\n\n", text)
+        return text.strip()
+
+
+def _decode_body(data: bytes, encoding: str) -> bytes:
+    encoding = encoding.lower().strip()
+    if not encoding or encoding == "identity":
+        output = data
+    elif encoding == "gzip":
+        with gzip.GzipFile(fileobj=io.BytesIO(data)) as stream:
+            output = stream.read(_MAX_DECOMPRESSED_BYTES + 1)
+    elif encoding == "deflate":
+        decompressor = zlib.decompressobj()
+        try:
+            output = decompressor.decompress(data, _MAX_DECOMPRESSED_BYTES + 1)
+        except zlib.error:
+            decompressor = zlib.decompressobj(-zlib.MAX_WBITS)
+            output = decompressor.decompress(data, _MAX_DECOMPRESSED_BYTES + 1)
+    else:
+        raise ValueError(f"Unsupported content encoding: {encoding}")
+    if len(output) > _MAX_DECOMPRESSED_BYTES:
+        raise ValueError("Decompressed response exceeds 8 MiB limit")
+    return output
+
+
+def _read_limited(response) -> bytes:
+    length = response.headers.get("Content-Length")
+    if length:
+        try:
+            if int(length) > _MAX_DOWNLOAD_BYTES:
+                raise ValueError("Response exceeds 4 MiB download limit")
+        except ValueError as exc:
+            if "exceeds" in str(exc):
+                raise
+    data = response.read(_MAX_DOWNLOAD_BYTES + 1)
+    if len(data) > _MAX_DOWNLOAD_BYTES:
+        raise ValueError("Response exceeds 4 MiB download limit")
+    return data
+
+
+def _fetch(url: str) -> tuple[str, str, bytes, str]:
+    opener = urllib.request.build_opener(
+        urllib.request.ProxyHandler({}),
+        _NoRedirect(),
+        _PublicHTTPHandler(),
+        _PublicHTTPSHandler(),
+    )
+    current = normalize_url_for_request(url)
+    for _hop in range(_MAX_REDIRECTS + 1):
+        if not is_safe_url(current):
+            raise ValueError("Blocked: redirect targets a private or internal network address")
+        request = urllib.request.Request(
+            current,
+            headers={
+                "User-Agent": "ChatBird-WebExtract/1.0 (+https://github.com/NousResearch/hermes-agent)",
+                "Accept": "text/html,application/xhtml+xml,text/plain,application/json,application/xml;q=0.9,*/*;q=0.1",
+                "Accept-Encoding": "gzip, deflate",
+            },
+        )
+        try:
+            response = opener.open(request, timeout=_TIMEOUT_SECONDS)
+        except urllib.error.HTTPError as exc:
+            response = exc
+        with response:
+            status = getattr(response, "status", response.getcode())
+            if status in {301, 302, 303, 307, 308}:
+                location = response.headers.get("Location")
+                if not location:
+                    raise ValueError(f"Redirect {status} has no Location header")
+                current = normalize_url_for_request(urllib.parse.urljoin(current, location))
+                continue
+            if status < 200 or status >= 300:
+                raise ValueError(f"HTTP {status}")
+            content_type = response.headers.get_content_type().lower()
+            if not any(content_type.startswith(item) for item in _ALLOWED_CONTENT_TYPES):
+                raise ValueError(f"Unsupported content type: {content_type}")
+            charset = response.headers.get_content_charset() or "utf-8"
+            data = _decode_body(_read_limited(response), response.headers.get("Content-Encoding", ""))
+            return current, content_type, data, charset
+    raise ValueError("Redirect limit exceeded")
+
+
+def _extract_one(url: str) -> Dict[str, Any]:
+    try:
+        final_url, content_type, data, charset = _fetch(url)
+        try:
+            decoded = data.decode(charset, errors="replace")
+        except LookupError:
+            decoded = data.decode("utf-8", errors="replace")
+        if "html" in content_type:
+            parser = _ReadableHTML()
+            parser.feed(decoded)
+            title = parser.title
+            content = parser.markdown()
+        else:
+            title = ""
+            content = decoded.strip()
+        return {
+            "url": final_url,
+            "title": title,
+            "content": content,
+            "raw_content": content,
+            "metadata": {"content_type": content_type},
+        }
+    except (urllib.error.URLError, socket.timeout, TimeoutError, ValueError, OSError) as exc:
+        return {"url": url, "title": "", "content": "", "raw_content": "", "error": str(exc)}
+
+
+class SimpleHTTPExtractProvider(WebSearchProvider):
+    @property
+    def name(self) -> str:
+        return "simple-http"
+
+    @property
+    def display_name(self) -> str:
+        return "Simple HTTP extractor"
+
+    def is_available(self) -> bool:
+        # Extraction only and needs no key, so it must not win the autodetect walk for an
+        # unconfigured install: it counts only when selected by name.
+        from tools.web_tools import _configured_backend
+
+        return self.name in (_configured_backend("extract_backend"), _configured_backend())
+
+    def supports_search(self) -> bool:
+        return False
+
+    def supports_extract(self) -> bool:
+        return True
+
+    def extract(self, urls: List[str], **kwargs: Any) -> List[Dict[str, Any]]:
+        return [_extract_one(url) for url in urls]
diff --git a/tools/public_skill_policy.py b/tools/public_skill_policy.py
new file mode 100644
index 0000000000..9fe4f7a861
--- /dev/null
+++ b/tools/public_skill_policy.py
@@ -0,0 +1,324 @@
+"""Fail-closed visibility and review state for ChatBird public skills.
+
+Public approval is stored outside skill directories and is bound to a digest
+of every file the skill reader could expose.  Editing any file therefore
+removes the skill from public Discord views until it is reviewed again.
+"""
+
+from __future__ import annotations
+
+import contextvars
+import hashlib
+import json
+import os
+import re
+import tempfile
+import threading
+from dataclasses import dataclass
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Callable, Optional
+
+from hermes_constants import get_hermes_home
+from utils import atomic_replace
+
+
+_MANIFEST_LOCK = threading.RLock()
+_REVIEW_CALLBACK: contextvars.ContextVar[Optional[Callable[[Path, str], "ReviewDecision"]]] = (
+    contextvars.ContextVar("chatbird_public_skill_reviewer", default=None)
+)
+_GUILD_SUFFIX_RE = re.compile(r"(?:^|:)guild-(\d+)(?:$|:)")
+_FORBIDDEN_PUBLIC_SKILL_PATTERNS = (
+    (re.compile(r"(?i)\b(?:terminal|shell|bash|powershell|execute_code|delegate_task|send_message|computer_use|browser|read_file|write_file|apply_patch|ssh|scp)\b"),
+     "references a tool unavailable in public channels"),
+    (re.compile(r"(?i)\b(?:skill_manage|memory|session|schedule|cron|admin(?:istrator)?|systemd|service)\b"),
+     "references stateful or administrative capabilities"),
+    (re.compile(r"(?i)(?:api[_ -]?key|access[_ -]?token|password|credential|secret|\.env)"),
+     "references credentials or secret-bearing configuration"),
+    (re.compile(r"(?i)(?:/root/|/etc/|/proc/|/sys/|~[/\\]|HERMES_HOME|HERMES_SKILL_DIR|HERMES_SESSION_ID|CHATBIRD_ADMIN)"),
+     "references host or privileged paths/configuration"),
+    (re.compile(r"(?i)(?:localhost|(?:127|10|0)\.\d{1,3}\.\d{1,3}\.\d{1,3}|172\.(?:1[6-9]|2\d|3[01])\.\d{1,3}\.\d{1,3}|192\.168\.\d{1,3}\.\d{1,3}|169\.254\.\d{1,3}\.\d{1,3}|::1|f[cd][0-9a-f]*:|fe80:|metadata\.google\.internal)"),
+     "references local or metadata network targets"),
+    (re.compile(r"!`[^`\n]*`"),
+     "contains executable inline shell syntax"),
+    (re.compile(r"(?:\$\{[^}\n]+\}|\{\{.*?\}\}|\{%.*?%\}|<%.*?%>)"),
+     "contains dynamic template syntax"),
+    (re.compile(r"<!--[\s\S]*?-->"),
+     "contains hidden HTML instructions"),
+    (re.compile(r"(?i)(?:ignore|bypass|override|disregard).{0,40}(?:policy|permission|system|instruction|guard)"),
+     "attempts to bypass policy or higher-priority instructions"),
+)
+_PUBLIC_TEXT_SUFFIXES = frozenset({".md", ".txt", ".json", ".yaml", ".yml", ".csv", ".tsv"})
+_INVISIBLE_INSTRUCTION_RE = re.compile(
+    "[\u200b\u200c\u200d\u2060\ufeff\u202a-\u202e\u2066-\u2069]"
+)
+
+
+@dataclass(frozen=True)
+class ReviewDecision:
+    approved: bool
+    reason: str
+    reviewer: str = ""
+
+
+def _session_value(name: str) -> str:
+    try:
+        from gateway.session_context import get_session_env
+
+        return str(get_session_env(name, "") or "")
+    except Exception:
+        return ""
+
+
+def _discord_context() -> dict[str, str]:
+    session_key = _session_value("HERMES_SESSION_KEY")
+    match = _GUILD_SUFFIX_RE.search(session_key)
+    return {
+        "platform": _session_value("HERMES_SESSION_PLATFORM").lower(),
+        "guild_id": match.group(1) if match else "",
+        "user_id": _session_value("HERMES_SESSION_USER_ID"),
+        "chat_id": _session_value("HERMES_SESSION_CHAT_ID"),
+    }
+
+
+def _csv_env(name: str) -> set[str]:
+    return {item.strip() for item in os.getenv(name, "").split(",") if item.strip()}
+
+
+def _admin_pairs() -> set[tuple[str, str]]:
+    pairs: set[tuple[str, str]] = set()
+    for item in _csv_env("CHATBIRD_ADMIN_CHANNELS"):
+        guild_id, separator, channel_id = item.partition(":")
+        if separator and guild_id.isdigit() and channel_id.isdigit():
+            pairs.add((guild_id, channel_id))
+    return pairs
+
+
+def is_public_discord_context() -> bool:
+    """Filter every Discord turn unless it is a fully identified admin turn.
+
+    Missing guild/user/channel identity cannot prove administrator status, so
+    it deliberately falls into the public, fail-closed view.
+    """
+    ctx = _discord_context()
+    if ctx["platform"] != "discord":
+        return False
+    is_admin = (
+        ctx["guild_id"].isdigit()
+        and ctx["user_id"].isdigit()
+        and ctx["chat_id"].isdigit()
+        and ctx["user_id"] in _csv_env("CHATBIRD_ADMIN_USERS")
+        and (ctx["guild_id"], ctx["chat_id"]) in _admin_pairs()
+    )
+    return not is_admin
+
+
+def _manifest_path() -> Path:
+    return get_hermes_home() / "chatbird" / "public-skill-approvals.json"
+
+
+def _read_manifest() -> dict:
+    try:
+        payload = json.loads(_manifest_path().read_text(encoding="utf-8"))
+    except (FileNotFoundError, OSError, ValueError, TypeError):
+        return {"version": 1, "skills": {}}
+    if not isinstance(payload, dict) or payload.get("version") != 1:
+        return {"version": 1, "skills": {}}
+    if not isinstance(payload.get("skills"), dict):
+        return {"version": 1, "skills": {}}
+    return payload
+
+
+def _write_manifest(payload: dict) -> None:
+    path = _manifest_path()
+    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
+    fd, tmp_name = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.")
+    try:
+        with os.fdopen(fd, "w", encoding="utf-8") as stream:
+            json.dump(payload, stream, ensure_ascii=False, indent=2, sort_keys=True)
+            stream.write("\n")
+            stream.flush()
+            os.fsync(stream.fileno())
+        os.chmod(tmp_name, 0o600)
+        atomic_replace(tmp_name, path)
+    finally:
+        try:
+            os.unlink(tmp_name)
+        except FileNotFoundError:
+            pass
+
+
+def skill_content_digest(skill_path: Path) -> Optional[str]:
+    """Hash all regular files beneath a skill, rejecting links and odd files."""
+    try:
+        root = skill_path.resolve(strict=True)
+        if root.is_file():
+            if skill_path.is_symlink():
+                return None
+            files = [root]
+            base = root.parent
+        elif root.is_dir():
+            entries = sorted(root.rglob("*"))
+            if any(path.is_symlink() for path in entries):
+                return None
+            if any(not path.is_dir() and not path.is_file() for path in entries):
+                return None
+            files = [path for path in entries if path.is_file()]
+            base = root
+        else:
+            return None
+        if not files or not any(path.name == "SKILL.md" for path in files):
+            return None
+
+        digest = hashlib.sha256()
+        total = 0
+        for path in files:
+            if path.is_symlink():
+                return None
+            resolved = path.resolve(strict=True)
+            resolved.relative_to(base)
+            data = resolved.read_bytes()
+            total += len(data)
+            if total > 2 * 1024 * 1024:
+                return None
+            relative = resolved.relative_to(base).as_posix().encode("utf-8")
+            digest.update(len(relative).to_bytes(4, "big"))
+            digest.update(relative)
+            digest.update(len(data).to_bytes(8, "big"))
+            digest.update(data)
+        return digest.hexdigest()
+    except (OSError, ValueError, RuntimeError):
+        return None
+
+
+def validate_public_skill_content(skill_path: Path) -> Optional[str]:
+    """Return a rejection reason when a candidate exceeds public capabilities."""
+    try:
+        root = skill_path.resolve(strict=True)
+        files = [root] if root.is_file() else sorted(root.rglob("*"))
+        if skill_path.is_symlink() or any(path.is_symlink() for path in files):
+            return "Public skills may not contain symbolic links."
+        if any(not path.is_dir() and not path.is_file() for path in files):
+            return "Public skills may contain only regular text files and directories."
+        regular_files = [path for path in files if path.is_file()]
+        if not regular_files or not any(path.name == "SKILL.md" for path in regular_files):
+            return "Candidate is missing SKILL.md."
+        for path in regular_files:
+            relative = path.name if root.is_file() else path.relative_to(root).as_posix()
+            if relative.startswith("scripts/") or path.suffix.lower() not in _PUBLIC_TEXT_SUFFIXES:
+                return f"Public skills may contain only inert text resources; rejected '{relative}'."
+            try:
+                content = path.read_text(encoding="utf-8")
+            except (OSError, UnicodeError):
+                return f"Public skill resource '{relative}' is unreadable text."
+            if _INVISIBLE_INSTRUCTION_RE.search(content):
+                return f"Public skill resource '{relative}' contains hidden or bidirectional text."
+            for pattern, reason in _FORBIDDEN_PUBLIC_SKILL_PATTERNS:
+                match = pattern.search(content)
+                if match:
+                    return f"{relative} {reason}: '{match.group(0)[:80]}'."
+        return None
+    except (OSError, ValueError, RuntimeError) as exc:
+        return f"Candidate could not be safely inspected: {exc}"
+
+
+def _approval_key(skill_path: Path, public_name: str) -> str:
+    try:
+        canonical = str(skill_path.resolve(strict=True))
+    except OSError:
+        canonical = str(skill_path.absolute())
+    return hashlib.sha256(f"{public_name}\0{canonical}".encode("utf-8")).hexdigest()
+
+
+def is_skill_publicly_approved(skill_path: Path, public_name: str) -> bool:
+    """Fail closed unless the external approval matches current content."""
+    digest = skill_content_digest(skill_path)
+    if not digest:
+        return False
+    with _MANIFEST_LOCK:
+        entry = _read_manifest()["skills"].get(_approval_key(skill_path, public_name))
+    return (
+        isinstance(entry, dict)
+        and entry.get("name") == public_name
+        and entry.get("sha256") == digest
+        and entry.get("status") == "approved"
+    )
+
+
+def record_public_approval(
+    skill_path: Path,
+    public_name: str,
+    *,
+    reviewer: str,
+    reason: str,
+) -> bool:
+    if validate_public_skill_content(skill_path):
+        return False
+    digest = skill_content_digest(skill_path)
+    if not digest:
+        return False
+    with _MANIFEST_LOCK:
+        payload = _read_manifest()
+        payload["skills"][_approval_key(skill_path, public_name)] = {
+            "name": public_name,
+            "path": str(skill_path.resolve()),
+            "sha256": digest,
+            "status": "approved",
+            "reviewer": reviewer,
+            "reason": reason[:500],
+            "reviewed_at": datetime.now(timezone.utc).isoformat(),
+        }
+        _write_manifest(payload)
+    return True
+
+
+def revoke_public_approval(skill_path: Path, public_name: str) -> None:
+    with _MANIFEST_LOCK:
+        payload = _read_manifest()
+        payload["skills"].pop(_approval_key(skill_path, public_name), None)
+        _write_manifest(payload)
+
+
+def public_approval_cache_token() -> str:
+    """Return a cache discriminator that changes on approval or skill edits."""
+    if not is_public_discord_context():
+        return "private"
+    with _MANIFEST_LOCK:
+        payload = _read_manifest()
+    digest = hashlib.sha256(json.dumps(payload, sort_keys=True).encode("utf-8"))
+    # Include current content digests, not only mtimes and sizes. This keeps the
+    # prompt LRU hash-bound even if an out-of-band edit preserves filesystem
+    # metadata.
+    for entry in payload.get("skills", {}).values():
+        if not isinstance(entry, dict) or not isinstance(entry.get("path"), str):
+            digest.update(b"malformed-path")
+            continue
+        try:
+            root = Path(entry["path"]).resolve(strict=True)
+            current = skill_content_digest(root)
+            digest.update(str(root).encode("utf-8"))
+            digest.update((current or "unreadable").encode("ascii"))
+        except OSError:
+            digest.update(b"unreadable")
+    return digest.hexdigest()
+
+
+def set_public_skill_reviewer(callback: Callable[[Path, str], ReviewDecision]):
+    return _REVIEW_CALLBACK.set(callback)
+
+
+def reset_public_skill_reviewer(token) -> None:
+    _REVIEW_CALLBACK.reset(token)
+
+
+def review_public_skill(skill_path: Path, public_name: str) -> ReviewDecision:
+    callback = _REVIEW_CALLBACK.get()
+    if callback is None:
+        return ReviewDecision(False, "No independent public-skill reviewer is available.")
+    try:
+        decision = callback(skill_path, public_name)
+    except Exception as exc:
+        return ReviewDecision(False, f"Independent public-skill review failed: {exc}")
+    if not isinstance(decision, ReviewDecision):
+        return ReviewDecision(False, "Independent public-skill reviewer returned malformed output.")
+    return decision
