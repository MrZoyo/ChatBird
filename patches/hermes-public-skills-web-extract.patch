+    worker = threading.Thread(target=_run, daemon=True, name="public-skill-review")
+    worker.start()
+    worker.join(timeout=_PUBLIC_SKILL_REVIEW_TIMEOUT_SECONDS)
+    if worker.is_alive():
+        return ReviewDecision(False, "Independent public-skill review timed out.")
+    if error_holder:
+        return ReviewDecision(False, f"Independent public-skill review failed: {error_holder['error']}")
+    response = result_holder.get("response")
+    if isinstance(response, dict):
+        text = str(response.get("final_response") or "")
+    else:
+        text = str(response or "")
+    payload = _extract_json_object(text)
+    if not payload or payload.get("decision") not in {"approve", "reject"}:
+        return ReviewDecision(False, "Independent public-skill reviewer returned malformed output.")
+    reason = str(payload.get("reason") or "No review reason supplied.")[:500]
+    return ReviewDecision(
