+def _is_approved_skill(name: Any) -> bool:
+    """True when ``name`` is a publicly approved skill; a broken policy counts as approved."""
+    from tools import skill_manager_tool as manager
+
+    existing = manager._find_skill(name) if isinstance(name, str) and name else None
+    if not existing:
+        return False
+    try:
+        from tools.public_skill_policy import is_skill_publicly_approved
+
+        return is_skill_publicly_approved(existing["path"], _skill_public_name(existing["path"], name))
+    except Exception:
+        return True
+
+
+def intercept_skill_manage(
+    action: str, name: str, operations: Any, **fields: Any,
+) -> Optional[str]:
+    """The tool result when a background review's write must go through public review, else None."""
+    from tools.skill_provenance import is_background_review
+
+    if not is_background_review():
+        return None
+    if operations is not None:
+        if isinstance(operations, list) and len(operations) == 1 and isinstance(operations[0], dict):
+            op = dict(operations[0])
+            action, name = op.get("action", ""), op.get("name") or name
+        else:
+            # A batch applies atomically but has one review verdict per skill, so it cannot mix in a
+            # public skill. Anything else is the normal batch path's to validate.
+            ops = operations if isinstance(operations, list) else []
+            names = [(op.get("name") or name) if isinstance(op, dict) else name for op in ops]
+            try:
+                from tools.public_skill_policy import is_public_discord_context
+
+                public = is_public_discord_context()
+            except Exception:
+                public = _is_background_discord_origin()
+            if public or any(_is_approved_skill(item) for item in names):
+                return json.dumps(_rejected("A public skill review accepts one operation per call."), ensure_ascii=False)
+            return None
+    else:
+        op = {"action": action, **fields}
+    result: Optional[dict[str, Any]] = None
+    if action == "create":
+        result = _review_and_publish_new(name, op.get("content") or "", op.get("category"))
+    elif action in {"edit", "patch", "write_file", "remove_file"}:
+        from tools import skill_manager_tool as manager
+
+        existing = manager._find_skill(name)
+        if existing:
+            result = _review_and_publish_update(name, existing["path"], op)
+    elif action == "delete":
+        try:
+            from tools.public_skill_policy import is_public_discord_context
+
+            if is_public_discord_context():
+                result = {"success": False, "error": "Public-channel background review cannot delete skills."}
+        except Exception as exc:
+            if _is_background_discord_origin():
+                result = {"success": False, "error": f"Public skill policy is unavailable; deletion was rejected: {exc}"}
+    return None if result is None else json.dumps(result, ensure_ascii=False)
