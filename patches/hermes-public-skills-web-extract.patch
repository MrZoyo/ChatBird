+        for path in sorted(skill_path.rglob("*")):
+            if not path.is_file():
+                continue
+            content = path.read_text(encoding="utf-8")
+            total += len(content)
+            if total > 250_000:
+                return ReviewDecision(False, "Candidate exceeds the independent review size limit.")
+            rendered.append(f"FILE: {path.relative_to(skill_path).as_posix()}\n{content}")
+    except Exception as exc:
