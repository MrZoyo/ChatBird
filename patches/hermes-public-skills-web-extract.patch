+                ),
+                system_message=_PUBLIC_SKILL_REVIEW_SYSTEM_PROMPT,
+                conversation_history=[],
+            )
+            result_holder["response"] = response
+        except BaseException as exc:
+            error_holder["error"] = exc
+        finally:
+            try:
+                clear_thread_tool_whitelist()
+            except Exception:
+                pass
+            if reviewer is not None:
+                try:
+                    reviewer.close()
+                except Exception:
+                    pass
