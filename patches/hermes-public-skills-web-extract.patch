+                skip_memory=True,
+                skip_context_files=True,
+                ephemeral_system_prompt=_PUBLIC_SKILL_REVIEW_SYSTEM_PROMPT,
+            )
+            reviewer._memory_enabled = False
+            reviewer._user_profile_enabled = False
+            reviewer._memory_nudge_interval = 0
+            reviewer._skill_nudge_interval = 0
+            reviewer.suppress_status_output = True
