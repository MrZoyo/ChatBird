+            decision = review_public_skill(candidate, public_name)
+            if not decision.approved:
+                return _rejected(decision.reason)
+            destination.parent.mkdir(parents=True, exist_ok=True)
+            if destination.exists():
+                return _rejected(f"Skill destination '{destination}' exists.")
+            os.replace(candidate, destination)
+            if not record_public_approval(
+                destination, public_name, reviewer=decision.reviewer or "independent-agent", reason=decision.reason,
+            ):
+                shutil.rmtree(destination, ignore_errors=True)
+                return _rejected("Could not bind approval to the published content.")
+            _refresh_prompt_index(created=name)
+            return {"success": True, "message": f"Skill '{name}' created and approved for public channels.",
+                    "path": _display_path(destination), "public_review": "approved"}
+        except Exception as exc:
+            if destination.exists():
+                shutil.rmtree(destination, ignore_errors=True)
